<Window x:Class="GeekDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:GeekDesk.Control.UserControls.PannelCard"
        xmlns:cn="clr-namespace:GeekDesk.Constant"
        xmlns:xf="clr-namespace:XamlFlair;assembly=XamlFlair.WPF"
        xmlns:local="clr-namespace:GeekDesk"
        mc:Ignorable="d"
        xmlns:cvt="clr-namespace:GeekDesk.Converts"
        x:Name="AppWindow"
        xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:viewmodel="clr-namespace:GeekDesk.ViewModel" 
        xmlns:my="clr-namespace:GeekDesk.Util"
        d:DataContext="{d:DesignInstance Type=viewmodel:AppData}"
        Title="GeekDesk_Main_8400A17AEEF7C029" 
        MinWidth="180"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Opacity="1"
        Deactivated="AppWindow_Deactivated"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="OnKeyDown"
        Focusable="True"
        MouseDown="MainWindow_MouseDown"
        MouseEnter="MainWindow_MouseEnter"
        GotFocus="Window_GotFocus"
        Loaded="Window_Loaded"   
        SourceInitialized="Window_SourceInitialized"
        Topmost="{Binding AppConfig.AlwaysTopmost}"
        >

    <Window.Resources>
        <RoutedUICommand x:Key="SearchHotKeyDown" Text="SearchHotKeyDown"/>
        <cvt:MenuWidthConvert x:Key="MenuWidthConvert"/>
        <cvt:OpcityConvert x:Key="OpcityConvert"/>
        <cvt:IntToCornerRadius x:Key="IntToCornerRadius"/>
        <cvt:DoubleToGridLength x:Key="DoubleToGridLength"/>
        <cvt:ReverseBoolConvert x:Key="ReverseBoolConvert"/>

        <!-- 音速启动经典红黄绿水晶控制按钮样式 (鼠标移入时显示 x, -, + 矢量符号) -->
        <Style x:Key="CrystalButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="btnBorder" CornerRadius="7.5" Background="{TemplateBinding Background}" BorderBrush="#55000000" BorderThickness="0.6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="2" Direction="-90" ShadowDepth="1" Opacity="0.25"/>
                                </Border.Effect>
                            </Border>
                            <!-- 鼠标移入时显现的 x, -, + 符号 -->
                            <Path x:Name="btnSymbol"
                                  Data="{TemplateBinding Tag}"
                                  Stroke="#4A0E0E"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="9" Height="9"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnSymbol" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                                <Setter TargetName="btnSymbol" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="8" ResizeBorderThickness="10"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+F" Key="F" Command="{StaticResource SearchHotKeyDown}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource SearchHotKeyDown}" CanExecute="SearchHotKeyDown"/>
    </Window.CommandBindings>

    <Grid>
        <Border Margin="15" CornerRadius="6"  
            BorderThickness="1"
            BorderBrush="#9CA3AF"
            Focusable="True"
            Panel.ZIndex="1"
            x:Name="BGBorder"
            Background="#FFFFFF"
            hc:Dialog.Token="MainWindowDialog"
            xf:Animations.Primary="{xf:Animate BasedOn={StaticResource FadeInAndGrowHorizontally}, Event=None}"
            xf:Animations.PrimaryBinding="{Binding AppConfig.IsShow, Mode=OneWay}"
            xf:Animations.Secondary="{xf:Animate BasedOn={StaticResource FadeOut}, Event=None}"
            xf:Animations.SecondaryBinding="{Binding AppConfig.IsShow, Mode=OneWay, Converter={StaticResource ReverseBoolConvert}}"
            xf:Animations.SecondaryCompletionCommand="{Binding HideCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
            xf:Animations.AllowOpacityReset="False"
            >
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Direction="-90" Color="#444444"
                              RenderingBias="Quality" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <hc:DialogContainer Focusable="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 1. 顶部标题与控制栏 -->
                        <RowDefinition Height="32"></RowDefinition>
                        <!-- 2. 主体抽屉/图标区 (包含悬浮搜索条) -->
                        <RowDefinition Height="*"></RowDefinition>
                        <!-- 3. 底部快捷工具栏 -->
                        <RowDefinition Height="28"></RowDefinition>
                    </Grid.RowDefinitions>

                    <CheckBox Style="{StaticResource MyCheckBoxStyle}" x:Name="ShowBox" Visibility="Hidden" Panel.ZIndex="2"/>
                    <CheckBox Style="{StaticResource MyCheckBoxStyle}" x:Name="HideBox" Visibility="Hidden" Panel.ZIndex="2"/>

                    <StackPanel HorizontalAlignment="Center" Panel.ZIndex="99" hc:Growl.GrowlParent="False" hc:Growl.Token="MainWindowAskGrowl" Grid.Row="1"/>

                    <!-- 标题栏与常用操作 (紧凑精致) -->
                    <Border Grid.Row="0" CornerRadius="5,5,0,0" BorderThickness="0,0,0,1" BorderBrush="#9EACB9" MouseDown="DragMove" x:Name="TitleBarBorder">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#ECEFF2" Offset="0.0"/>
                                <GradientStop Color="#D8DFE6" Offset="0.5"/>
                                <GradientStop Color="#C1CBD4" Offset="0.51"/>
                                <GradientStop Color="#B2BEC9" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="8,0,8,0">
                            <!-- 左上角经典红黄绿水晶三色按钮 (Hover出现 x, -, +) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,8,0">
                                <!-- 红色: 关闭/隐藏 (x) -->
                                <Button Style="{StaticResource CrystalButtonStyle}"
                                        Tag="{StaticResource SonicCloseSymbol}"
                                        ToolTip="关闭/隐藏面板"
                                        Click="CloseButtonClick">
                                    <Button.Background>
                                        <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#FFA4A4" Offset="0.0"/>
                                            <GradientStop Color="#FF5F56" Offset="0.6"/>
                                            <GradientStop Color="#D63A33" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Button.Background>
                                </Button>
                                <!-- 黄色: 最小化/贴边隐藏 (-) -->
                                <Button Style="{StaticResource CrystalButtonStyle}"
                                        Tag="{StaticResource SonicMinSymbol}"
                                        ToolTip="最小化/贴边收起"
                                        Click="CloseButtonClick">
                                    <Button.Background>
                                        <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#FFE888" Offset="0.0"/>
                                            <GradientStop Color="#FFBD2E" Offset="0.6"/>
                                            <GradientStop Color="#D99714" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Button.Background>
                                </Button>
                            </StackPanel>

                            <!-- 右侧操作栏 (风格切换、搜索、设置) -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <!-- 风格切换按钮 (音速启动抽屉 / 小Q书桌模式) -->
                                <Button Background="Transparent" BorderThickness="0" Padding="3" Margin="0,0,3,0" FocusVisualStyle="{x:Null}" ToolTip="切换启动器风格 (音速启动 / 小Q书桌)" Click="ToggleLauncherStyle_Click" x:Name="StyleSwitchBtn">
                                    <Path x:Name="StyleSwitchPath" Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"
                                          Fill="#4B5563" Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <!-- 独立的搜索按钮 -->
                                <Button Background="Transparent" BorderThickness="0" Padding="3" Margin="0,0,3,0" FocusVisualStyle="{x:Null}" ToolTip="快速搜索图标" Click="ToggleSearchBoxClick">
                                    <Path x:Name="SearchBtnPath" Data="M416 128C256.96 128 128 256.96 128 416s128.96 288 288 288 288-128.96 288-288S607.04 128 416 128z m0 512c-123.712 0-224-100.288-224-224S292.288 192 416 192s224 100.288 224 224-100.288 224-224 224z m441.376 307.2l-176.64-176.64a32 32 0 0 0-45.248 45.248l176.64 176.64a32 32 0 0 0 45.248-45.248z"
                                          Fill="#4B5563" Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <!-- 设置齿轮按钮 -->
                                <Button Background="Transparent" BorderThickness="0" Padding="3" FocusVisualStyle="{x:Null}" ToolTip="设置与选项" Click="SettingButton_Click" x:Name="MainSettingBtn">
                                    <Path x:Name="SettingBtnPath" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                          Fill="#4B5563" Width="14" Height="14" Stretch="Uniform"/>
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="GearContextMenu" Width="170">
                                            <MenuItem Header="窗口置顶/固定" Click="ToggleTopmostClick" x:Name="PinMenuItem"/>
                                            <Separator/>
                                            <MenuItem Header="外观风格">
                                                <MenuItem Header="macOS 磨砂质感" Click="SwitchTheme_Mac" Tag="MacAcrylic"/>
                                                <MenuItem Header="纯净极简现代" Click="SwitchTheme_Minimal" Tag="PureMinimal"/>
                                                <MenuItem Header="经典金属微拟物" Click="SwitchTheme_Crystal" Tag="CrystalSkeuomorphic"/>
                                            </MenuItem>
                                            <MenuItem Header="高级设置" Click="ConfigButtonClick"/>
                                            <MenuItem Header="关于" Click="MenuAbout_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>

                            <!-- 中间/左侧标题 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Image Visibility="{Binding AppConfig.TitleLogoVisible}" 
                                       Source="/Resource/Image/TitleLogo.png" 
                                       RenderOptions.BitmapScalingMode="HighQuality" 
                                       Width="96" Height="22" Opacity="0.9"
                                       VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 第 2 行：主体内容层叠区 (手风琴抽屉 / 小Q书桌卡片 / 悬浮搜索栏 / 搜索结果) -->
                    <Grid Grid.Row="1" x:Name="MainContentContainer">
                        <!-- 1. 音速启动居中手风琴抽屉面板 -->
                        <uc:AccordionCardControl x:Name="AccordionCard" Visibility="Collapsed"/>

                        <!-- 2. 小Q书桌卡片面板 (左侧分类 + 右侧大网格) -->
                        <uc:XiaoQCardControl x:Name="XiaoQCard" Visibility="Visible"/>

                        <!-- 3. 悬浮精美搜索栏 (平时完全收起，点击搜索图标时悬浮在图标区域顶部，不占常驻行高) -->
                        <Border x:Name="SearchBarRow" Visibility="Collapsed" Panel.ZIndex="10"
                                VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8,6,8,0"
                                Background="#F9FAFB" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="-90" Color="#000000" Opacity="0.15" ShadowDepth="2"/>
                            </Border.Effect>
                            <Grid Margin="8,4,8,4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <!-- 放大镜小图标 -->
                                <Path Grid.Column="0" Fill="#6B7280" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Data="M416 128C256.96 128 128 256.96 128 416s128.96 288 288 288 288-128.96 288-288S607.04 128 416 128z m0 512c-123.712 0-224-100.288-224-224S292.288 192 416 192s224 100.288 224 224-100.288 224-224 224z m441.376 307.2l-176.64-176.64a32 32 0 0 0-45.248 45.248l176.64 176.64a32 32 0 0 0 45.248-45.248z"/>
                                <!-- 搜索文本框 -->
                                <TextBox Grid.Column="1" x:Name="SearchBox" Height="24" FontSize="12" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Margin="4,0,0,0" TextChanged="SearchBox_TextChanged"
                                         Style="{StaticResource MyTextBoxStyle}"/>
                                <!-- 清空/关闭搜索 -->
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="关闭搜索" Click="CloseSearchClick" FocusVisualStyle="{x:Null}">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                          Fill="#9CA3AF" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 4. 顶层: 搜索结果层 (当输入搜索时展示) -->
                        <uc:RightCardControl x:Name="RightCard" Visibility="Collapsed" Margin="0,42,0,0"/>
                    </Grid>

                    <Border x:Name="SearchResContainer" Panel.ZIndex="2" 
                        Visibility="Collapsed"
                        Grid.Row="1" 
                        HorizontalAlignment="Right" MaxWidth="200" 
                        VerticalAlignment="Top"
                        CornerRadius="4"
                        Margin="0,48,10,0"
                        >
                        <Border.Style>
                            <Style TargetType="Border" >
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="White" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="MaxWidth" Value="300"/>
                            </Style>
                        </Border.Style>
                        <WrapPanel Margin="6">
                            <TextBlock Opacity="0.7" Text="g:"/>
                            <TextBlock x:Name="GeekDeskSearchTotal" Opacity="0.7" Text="0"/>
                        </WrapPanel>
                    </Border>

                    <hc:NotifyIcon Icon="/Logo.ico" Click="NotifyIcon_Click" x:Name="BarIcon"
                            Visibility="{Binding AppConfig.ShowBarIcon, Mode=TwoWay, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <hc:NotifyIcon.ContextMenu>
                            <ContextMenu Width="130" x:Name="TaskbarContextMenu">
                                <MenuItem Header="打开面板" Click="ShowApp"/>
                                <MenuItem Header="拾色器" Click="ColorPicker"/>
                                <MenuItem Header="备份" Click="BakDataFile"/>
                                <MenuItem Header="隐藏图标" Click="CloseBarIcon"/>
                                <MenuItem Header="待办" Click="BacklogMenuClick"/>
                                <MenuItem Header="程序目录" Click="OpenThisDir"/>
                                <MenuItem Header="设置" Click="ConfigApp"/>
                                <MenuItem Header="重启" Click="ReStartApp"/>
                                <MenuItem Header="退出" Click="ExitApp"/>
                            </ContextMenu>
                        </hc:NotifyIcon.ContextMenu>
                    </hc:NotifyIcon>

                    <!-- 第 3 行：音速启动风格底部常用工具栏 -->
                    <Border Grid.Row="2" Background="#F1F3F5" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" x:Name="BottomToolbarBorder">
                        <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="4,0,4,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" x:Name="QuickToolsPanel">
                                <Button ToolTip="任务管理器" Click="QuickTool_TaskManager" Background="Transparent" BorderThickness="0" Padding="3,1" FocusVisualStyle="{x:Null}">
                                    <hc:IconElement.Geometry>
                                        M128 640h128l96-256 128 384 128-256 96 128h192v64H688l-80-106.666667-128 256-128-384-80 213.333334H128z
                                    </hc:IconElement.Geometry>
                                </Button>
                                <Button ToolTip="控制面板" Click="QuickTool_ControlPanel" Background="Transparent" BorderThickness="0" Padding="3,1" FocusVisualStyle="{x:Null}">
                                    <hc:IconElement.Geometry>
                                        M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64z m0 820c-205.4 0-372-166.6-372-372s166.6-372 372-372 372 166.6 372 372-166.6 372-372 372z
                                    </hc:IconElement.Geometry>
                                </Button>
                                <Button ToolTip="计算器" Click="QuickTool_Calc" Background="Transparent" BorderThickness="0" Padding="3,1" FocusVisualStyle="{x:Null}">
                                    <hc:IconElement.Geometry>
                                        M768 128H256c-35.3 0-64 28.7-64 64v640c0 35.3 28.7 64 64 64h512c35.3 0 64-28.7 64-64V192c0-35.3-28.7-64-64-64z m-64 640H320V256h384v512z
                                    </hc:IconElement.Geometry>
                                </Button>
                                <Button ToolTip="待办事项" Click="BacklogMenuClick" Background="Transparent" BorderThickness="0" Padding="3,1" FocusVisualStyle="{x:Null}">
                                    <hc:IconElement.Geometry>
                                        M864 128H160c-35.2 0-64 28.8-64 64v640c0 35.2 28.8 64 64 64h704c35.2 0 64-28.8 64-64V192c0-35.2-28.8-64-64-64z m-416 576H256v-64h192v64z m320-160H256v-64h512v64z m0-160H256v-64h512v64z
                                    </hc:IconElement.Geometry>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>


                </Grid>
            </hc:DialogContainer>
        </Border>
    </Grid>
</Window>
