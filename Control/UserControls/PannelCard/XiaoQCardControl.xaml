<UserControl x:Class="GeekDesk.Control.UserControls.PannelCard.XiaoQCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cvt="clr-namespace:GeekDesk.Converts"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="620"
             AllowDrop="True">

    <UserControl.Resources>
        <cvt:Boolean2VisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="XiaoQIconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.AppConfig.ImageWidth, Mode=OneWay}"/>
            <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.AppConfig.ImageHeight, Mode=OneWay}"/>
            <Setter Property="Source" Value="{Binding BitmapImage}"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>

        <!-- 分类导航栏右键菜单 -->
        <ContextMenu x:Key="CategoryContextMenu" Width="170">
            <MenuItem Header="新建分类" Click="CreateMenu_Click"/>
            <MenuItem Header="重命名分类" Click="RenameMenu_Click" Tag="{Binding}"/>
            <MenuItem Header="加密此分类" Click="EncryptMenu_Click" Tag="{Binding}"/>
            <Separator/>
            <MenuItem Header="删除分类" Click="DeleteMenu_Click" Tag="{Binding}"/>
        </ContextMenu>

        <!-- 图标项右键菜单 -->
        <ContextMenu x:Key="IconContextMenu" Width="190">
            <MenuItem Header="以管理员方式运行" Click="IconAdminStart_Click" Tag="{Binding}"/>
            <MenuItem Header="打开文件所在位置" Click="ShowInExplorer_Click" Tag="{Binding}"/>
            <MenuItem Header="添加URL项目" Click="AddUrlIcon_Click"/>
            <MenuItem Header="添加系统项目" Click="AddSystemIcon_Click"/>
            <MenuItem Header="资源管理器菜单" Click="SystemContextMenu_Click" Tag="{Binding}"/>
            <MenuItem Header="属性" Click="IconProperty_Click" Tag="{Binding}"/>
            <Separator/>
            <MenuItem Header="从分类中移除" Click="RemoveIcon_Click" Tag="{Binding}"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- 左侧分类导航栏 (宽度 130) -->
            <ColumnDefinition Width="130"/>
            <!-- 右侧大图标网格内容区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== 左侧垂直分类导航 ================== -->
        <Border Grid.Column="0" Background="#F1F3F5" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- 底部添加分类快捷条 -->
                <Border DockPanel.Dock="Bottom" Height="36" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="#ECEFF2"
                        Cursor="Hand" MouseLeftButtonDown="CreateMenu_Click" ToolTip="新建分类">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#6B7280" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                        <TextBlock Text="新建分类" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 分类列表 -->
                <hc:ScrollViewer IsInertiaEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="CategoryListBox" 
                             ItemsSource="{Binding MenuList}"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="CategoryListBox_SelectionChanged"
                             Padding="4,6,4,6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="ContextMenu" Value="{StaticResource CategoryContextMenu}"/>
                                <Setter Property="Margin" Value="0,2,0,2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="6" Height="34" Background="Transparent" Cursor="Hand" Padding="8,0,8,0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#374151"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#E5E7EB"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource MyTextBoxStyle}" 
                                             Text="{Binding MenuName, Mode=TwoWay}"
                                             FontSize="13"
                                             Height="24"
                                             BorderThickness="0"
                                             LostFocus="MenuRename_LostFocus"
                                             KeyDown="MenuRename_KeyDown"
                                             Tag="{Binding}"
                                             Visibility="{Binding MenuEdit}"/>

                                    <TextBlock Text="{Binding MenuName}" 
                                               FontSize="13" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding NotMenuEdit}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1F2937"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </hc:ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================== 右侧大图标网格内容区 ================== -->
        <Border Grid.Column="1" Background="#FFFFFF" AllowDrop="True" Drop="IconsArea_Drop" x:Name="RightIconsBorder">
            <hc:ScrollViewer IsInertiaEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                <ListBox x:Name="IconGridListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         AllowDrop="True"
                         Drop="IconsArea_Drop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,2,4,2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="ContextMenu" Value="{StaticResource IconContextMenu}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <hc:SimpleStackPanel Width="76"
                                                 Height="76"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Margin="3"
                                                 Cursor="Hand"
                                                 MouseLeftButtonDown="Icon_MouseLeftButtonDown"
                                                 ToolTip="{Binding Content}"
                                                 Tag="{Binding}">
                                <Image Style="{StaticResource XiaoQIconImageStyle}"/>
                                <TextBlock Text="{Binding Name}" 
                                           MaxWidth="70"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"
                                           Foreground="#1F2937"
                                           Visibility="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.AppConfig.ShowIconTitle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </hc:SimpleStackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </hc:ScrollViewer>
        </Border>
    </Grid>
</UserControl>
