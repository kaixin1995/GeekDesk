<Window x:Class="GeekDesk.Control.Windows.TrayHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="GeekDesk_TrayHost"
        Width="1" Height="1"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000"
        Background="Transparent">
    <Window.Resources>
        <cvt:Boolean2VisibilityConverter x:Key="Boolean2VisibilityConverter" xmlns:cvt="clr-namespace:GeekDesk.Converts" />
    </Window.Resources>
    <!-- 托盘图标独立宿主: 与主窗口视觉树彻底分离, 主面板的显示/贴边/动画/主题操作
         不再牵连托盘图标, 规避 HandyControl NotifyIcon 在 Loaded 重入时重复注册图标的问题 -->
    <hc:NotifyIcon Icon="/Logo.ico" Click="NotifyIcon_Click" x:Name="BarIcon"
                   Text="GeekDesk"
                   Visibility="{Binding AppConfig.ShowBarIcon, Mode=TwoWay, Converter={StaticResource Boolean2VisibilityConverter}}">
        <hc:NotifyIcon.ContextMenu>
            <ContextMenu Width="130" x:Name="TaskbarContextMenu">
                <MenuItem Header="打开面板" Click="ShowPanel_Click"/>
                <MenuItem Header="拾色器" Click="ColorPicker_Click"/>
                <MenuItem Header="备份" Click="BakDataFile_Click"/>
                <MenuItem Header="隐藏图标" Click="CloseBarIcon_Click"/>
                <MenuItem Header="待办" Click="Backlog_Click"/>
                <MenuItem Header="程序目录" Click="OpenThisDir_Click"/>
                <MenuItem Header="设置" Click="ConfigApp_Click"/>
                <MenuItem Header="重启" Click="ReStartApp_Click"/>
                <MenuItem Header="退出" Click="ExitApp_Click"/>
            </ContextMenu>
        </hc:NotifyIcon.ContextMenu>
    </hc:NotifyIcon>
</Window>
