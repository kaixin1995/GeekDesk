<Window x:Class="GeekDesk.Control.Other.IconInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:cvt="clr-namespace:GeekDesk.Converts"
        Title="图标属性编辑"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        >
    <Window.Resources>
        <Style x:Key="LeftTB" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="Width" Value="68"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="8" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Direction="-90" Color="#000000" Opacity="0.3" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="14,12,14,14">
            <StackPanel>
                <!-- 顶部标题与关闭按钮 -->
                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Width="20" Height="20" Click="Close_Click" Style="{StaticResource ButtonIcon}" Foreground="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" hc:IconElement.Geometry="{StaticResource ErrorGeometry}" Padding="0"/>
                    <TextBlock Text="图标属性编辑" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
                </DockPanel>

                <hc:UniformSpacingPanel Spacing="8" Margin="0,6,0,0">
                    <TextBlock Text="名称:" Style="{StaticResource LeftTB}"/>
                    <TextBox x:Name="IconName" Style="{StaticResource MyTextBoxStyle}" Text="{Binding Name, Mode=OneWay}" Width="240" Height="28" FontSize="13"/>
                </hc:UniformSpacingPanel>

                <hc:UniformSpacingPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="绝对路径:" Style="{StaticResource LeftTB}"/>
                    <TextBox x:Name="IconPath" Style="{StaticResource MyTextBoxStyle}" Text="{Binding Path, Mode=OneWay}" Width="240" Height="28" FontSize="12" ToolTip="{Binding Path}"/>
                </hc:UniformSpacingPanel>

                <hc:UniformSpacingPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="图标:" Style="{StaticResource LeftTB}"/>
                    <Image x:Name="IconImg" Source="{Binding BitmapImage, Mode=OneWay}" RenderOptions.BitmapScalingMode="HighQuality" Width="44" Height="44" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource MyBtnStyle}" Content="修改" Height="26" Margin="12,0,0,0" Padding="10,2" Click="EditImage"/>
                    <Button Style="{StaticResource MyBtnStyle}" Content="重置" Height="26" Margin="6,0,0,0" Padding="10,2" Click="ReStoreImage"/>
                </hc:UniformSpacingPanel>

                <hc:UniformSpacingPanel Spacing="8" Margin="4,10,0,0">
                    <CheckBox x:Name="IconIsAdmin" Style="{StaticResource MyCheckBoxStyle}"
                              Content="始终以管理员方式启动" IsChecked="{Binding AdminStartUp, Mode=OneWay}"/>
                </hc:UniformSpacingPanel>

                <hc:UniformSpacingPanel Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="启动参数:" Style="{StaticResource LeftTB}" VerticalAlignment="Top" Margin="2,5,0,0"/>
                    <TextBox x:Name="StartArg" Style="{StaticResource MyTextBoxStyle}" Text="{Binding StartArg, Mode=OneWay}" Width="240" Height="50" TextWrapping="Wrap" FontSize="12"/>
                </hc:UniformSpacingPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="取消" Width="64" Height="28" Margin="0,0,8,0" Style="{StaticResource ButtonDefault}" Click="Close_Click"/>
                    <Button Content="保存" Width="64" Height="28" Style="{StaticResource ButtonPrimary}" Click="SaveProperty"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>